@model ClinicManager.Application.ViewModel.PacienteViewModel

<form asp-action="IncluiPaciente" asp-controller="Paciente" method="post">
    <div class="mb-3">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="DtNascimento"></label>
        <input asp-for="DtNascimento" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="CPF"></label>
        <input asp-for="CPF" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Telefone"></label>
        <input asp-for="Telefone" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Salvar
    </button>

</form>