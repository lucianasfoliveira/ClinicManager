@model IEnumerable<ClinicManager.Application.ViewModel.PacienteViewModel>

@* Título da página *@
<h2>Lista de Pacientes</h2>

@* Botão de inclusão *@
<button class="btn btn-primary mb-3" id="btnIncluiPaciente">
    <i class="bi bi-plus-lg"></i> Novo Paciente
</button>

@* Tabela estilizada com Bootstrap *@
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>CPF</th>
            <th>DtNascimento</th>
            <th>Telefone</th>
            <th>Email</th>
            <th>DtCadastro</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var paciente in Model)
        {
            <tr>
                <td>@paciente.Id</td>
                <td>@paciente.Nome</td>
                <td>@paciente.CPF</td>
                <td>@paciente.DtNascimento.ToString("dd/MM/yyyy")</td>
                <td>@paciente.Telefone</td>
                <td>@paciente.Email</td>
                <td>@paciente.DtCadastro</td>
                <td>
                    @* Dropdown de ações *@
                    <div class="dropdown">
                        <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton-@paciente.Id" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-@paciente.Id">
                            <li><a class="dropdown-item" href="#">Editar</a></li>
                            <li><a class="dropdown-item" href="#">Excluir</a></li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Opcional: Modal de inclusão/alteração (abre ao clicar no botão ou editar) *@
<div class="modal fade" id="modalFormPaciente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Incluir Paciente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="conteudoModal">
                @* Aqui você colocaria o formulário do paciente *@
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>

        $(document).on("click", "#btnIncluiPaciente", function () {

            $.get("/Paciente/IncluiPaciente", function (data) {

                $("#conteudoModal").html(data);

                var modal = new bootstrap.Modal(document.getElementById('modalFormPaciente'));
                modal.show();

            });

        });

    </script>

}